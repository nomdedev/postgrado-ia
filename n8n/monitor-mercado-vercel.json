    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response = $input.first().json;\nif (!response.ok || !response.data || !Array.isArray(response.data.tickers)) {\n  throw new Error('La API no devolvió una lista de activos válida.');\n}\nconst matches = response.data.tickers.filter((ticker) => ticker.signal === 'VENTA');\nreturn [{ json: { condition: 'VENTA', hasSignal: matches.length > 0, matches, session: response.data.session, message: matches.length ? 'Se encontraron ' + matches.length + ' señales VENTA.' : 'No se encontraron señales VENTA.' } }];"
      },
      "id": "947fbe26-718f-4621-92a6-618b387f31c1",

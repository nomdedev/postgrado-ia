    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Un item por activo: así la planilla recibe una fila por cada uno.\nconst d = $input.first().json.data;\nif (!d || !Array.isArray(d.tickers)) {\n  throw new Error('La API no devolvió la lista de activos.');\n}\n\nreturn d.tickers.map((t) => ({\n  json: {\n    fecha: d.session,\n    symbol: t.symbol,\n    nombre: t.name,\n    ultimo: t.last,\n    cambio_pct: t.change_pct,\n    volumen: t.volume,\n    rsi14: t.rsi14,\n    senal: t.signal\n  }\n}));"
      },
      "id": "4d000000-0000-4000-8000-000000000003",
      "name": "Aplanar activos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 320]
    },

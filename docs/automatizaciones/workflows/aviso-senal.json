      "id": "1a000000-0000-4000-8000-000000000002",
      "name": "Consultar API FIN·LAB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 320]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Buscá acá la señal que te interesa: 'VENTA', 'COMPRA' o 'NEUTRAL'.\nconst SENAL = 'VENTA';\n\nconst response = $input.first().json;\nif (!response.ok || !response.data || !Array.isArray(response.data.tickers)) {\n  throw new Error('La API no devolvió una lista de activos válida.');\n}\n\nconst matches = response.data.tickers.filter((t) => t.signal === SENAL);\nconst detalle = matches.map((t) => '- ' + t.symbol + ' (' + t.name + '): ' + t.last + ' USD · RSI ' + t.rsi14).join('\\n');\n\nreturn [{\n  json: {\n    session: response.data.session,\n    signal: SENAL,\n    hasSignal: matches.length > 0,\n    count: matches.length,\n    symbols: matches.map((t) => t.symbol).join(', '),\n    texto: matches.length\n      ? 'Señal ' + SENAL + ' en la sesión ' + response.data.session + ':\\n\\n' + detalle + '\\n\\nMuestra educativa fija de FIN·LAB. No es una recomendación de inversión.'\n      : 'Sin señales ' + SENAL + ' en la sesión ' + response.data.session + '.'\n  }\n}];"
      },
      "id": "1a000000-0000-4000-8000-000000000003",
      "name": "Filtrar señales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
